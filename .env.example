AUTH_SESSION_SECRET=replace-with-a-long-random-secret

# Shared secret used by ai-shop-mcp to be recognized as a trusted MCP caller (grants discount C).
MCP_AUTH_TOKEN=

# Use either the underscored names below, Railway's MYSQL* names, or MYSQL_URL/DATABASE_URL.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ai_shop
MYSQL_USER=root
MYSQL_PASSWORD=

# MYSQL_URL=mysql://user:password@host:3306/ai_shop
# DATABASE_URL=mysql://user:password@host:3306/ai_shop
